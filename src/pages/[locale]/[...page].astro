---
import type { GetStaticPaths } from 'astro';
import StudioHome from '../../components/StudioHome.astro';
import StudioAbout from '../../components/StudioAbout.astro';
import StudioSupport from '../../components/StudioSupport.astro';
import StudioLegal from '../../components/StudioLegal.astro';
import { languages } from '../../i18n/locales';

// Existing English and Chinese routes keep their public URLs.
export const getStaticPaths = (() => Object.keys(languages)
  .filter(locale => !['en', 'zh-cn', 'zh-tw'].includes(locale))
  .flatMap(locale => ['', 'about', 'support', 'privacy', 'terms'].map(page => ({
    params: { locale, page: page || undefined }, props: { page },
  })))) satisfies GetStaticPaths;

interface Props { page: string }
const { page } = Astro.props;
---
{page === '' && <StudioHome />}
{page === 'about' && <StudioAbout />}
{page === 'support' && <StudioSupport />}
{page === 'privacy' && <StudioLegal kind="privacy" />}
{page === 'terms' && <StudioLegal kind="terms" />}
