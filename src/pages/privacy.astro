---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t('privacy.title')} description={t('meta.privacy')}>
  <section class="page-hero">
    <h1 class="page-title">{t('privacy.title')}</h1>
    <p class="updated">{t('privacy.updated')}</p>
  </section>

  <section class="legal-body">
    <div>
      <h2>{t('privacy.s1.h')}</h2>
      <p>{t('privacy.s1.p1')}</p>
      <p>{t('privacy.s1.p2')}</p>

      <h2>{t('privacy.s2.h')}</h2>
      <p>{t('privacy.s2.p1')}</p>
      <ul>
        <li>{t('privacy.s2.app1')}</li>
        <li>{t('privacy.s2.app2')}</li>
        <li>{t('privacy.s2.app3')}</li>
        <li>{t('privacy.s2.app4')}</li>
      </ul>
      <p>{t('privacy.s2.p2')}</p>
      <ul>
        <li>{t('privacy.s2.li1')}</li>
        <li>{t('privacy.s2.li2')}</li>
        <li>{t('privacy.s2.li3')}</li>
        <li>{t('privacy.s2.li4')}</li>
      </ul>
      <p>{t('privacy.s2.analyticsP')}</p>
      <ul>
        <li>{t('privacy.s2.analyticsLi1')}</li>
        <li>{t('privacy.s2.analyticsLi2')}</li>
        <li>{t('privacy.s2.analyticsLi3')}</li>
        <li>{t('privacy.s2.analyticsLi4')}</li>
      </ul>
      <p>{t('privacy.s2.p3')}</p>

      <h2>{t('privacy.s3.h')}</h2>
      <p>{t('privacy.s3.p1')}</p>
      <ul>
        <li>{t('privacy.s3.li1')}</li>
        <li>{t('privacy.s3.li2')}</li>
        <li>{t('privacy.s3.li3')}</li>
        <li>{t('privacy.s3.li4')}</li>
        <li>{t('privacy.s3.li5')}</li>
        <li>{t('privacy.s3.li6')}</li>
      </ul>

      <h2>{t('privacy.s4.h')}</h2>
      <p>{t('privacy.s4.p1')}</p>
      <p>{t('privacy.s4.p2')}</p>
      <ul>
        <li><a href="https://policies.google.com/privacy">{t('privacy.s4.googlePrivacy')}</a></li>
        <li><a href="https://policies.google.com/technologies/partner-sites">{t('privacy.s4.googlePartners')}</a></li>
      </ul>
      <p>{t('privacy.s4.p3')}</p>
      <ul>
        <li><a href="https://gameanalytics.com/privacy/">{t('privacy.s4.gameAnalyticsPrivacy')}</a></li>
      </ul>

      <h2>{t('privacy.s5.h')}</h2>
      <p>{t('privacy.s5.p1')}</p>
      <p>{t('privacy.s5.p2')}</p>
      <p>{t('privacy.s5.p3')}</p>

      <h2>{t('privacy.s6.h')}</h2>
      <p>{t('privacy.s6.p1')}</p>
      <p>{t('privacy.s6.p2')}</p>
      <p>{t('privacy.s6.p3')}</p>

      <h2>{t('privacy.s7.h')}</h2>
      <p>{t('privacy.s7.p1')}</p>
      <p>{t('privacy.s7.p2')}</p>
      <p>{t('privacy.s7.p3')}</p>

      <h2>{t('privacy.s8.h')}</h2>
      <p>{t('privacy.s8.p1')}</p>
      <p>{t('privacy.s8.p2')}</p>

      <h2>{t('privacy.s9.h')}</h2>
      <p>{t('privacy.s9.p1')}</p>
      <ul>
        <li>{t('privacy.s9.li1')}</li>
        <li>{t('privacy.s9.li2')}</li>
        <li>{t('privacy.s9.li3')}</li>
        <li>{t('privacy.s9.li4')}</li>
      </ul>
      <p>{t('privacy.s9.p2')}</p>

      <h2>{t('privacy.s10.h')}</h2>
      <p>{t('privacy.s10.p1')}</p>

      <h2>{t('privacy.s11.h')}</h2>
      <p>{t('privacy.s11.p1')}</p>
      <p>Email: <a href="mailto:mogoostudio@outlook.com">mogoostudio@outlook.com</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 72px 40px 56px;
    text-align: center;
    background: #f8f8f8;
  }

  .page-title {
    font-size: clamp(36px, 6vw, 56px);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #222;
    margin-bottom: 12px;
  }

  .updated {
    font-family: "Nunito", sans-serif;
    font-size: 13px;
    color: #999;
  }

  .legal-body {
    max-width: 760px;
    margin: 0 auto;
    padding: 56px 40px 80px;
  }

  .legal-body h2 {
    font-size: 20px;
    font-weight: 800;
    color: #222;
    margin-top: 40px;
    margin-bottom: 12px;
  }

  .legal-body h2:first-child { margin-top: 0; }

  .legal-body p,
  .legal-body li {
    font-family: "Nunito", sans-serif;
    font-size: 14.5px;
    color: #555;
    line-height: 1.8;
  }

  .legal-body ul {
    padding-left: 20px;
    margin: 8px 0 16px;
  }

  .legal-body li { margin-bottom: 6px; }

  .legal-body a { color: #F2455C; }
  .legal-body a:hover { text-decoration: underline; }

  @media (max-width: 640px) {
    .legal-body { padding: 40px 24px 60px; }
  }
</style>
