---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const privacyPath = getLocalizedPath('/privacy/', lang);
---

<BaseLayout title={t('terms.title')} description={t('meta.terms')}>
  <section class="page-hero">
    <h1 class="page-title">{t('terms.title')}</h1>
    <p class="updated">{t('terms.updated')}</p>
  </section>

  <section class="legal-body">
    <div>
      <h2>{t('terms.s1.h')}</h2>
      <p>{t('terms.s1.p1')}</p>
      <p>{t('terms.s1.p2')}</p>

      <h2>{t('terms.s2.h')}</h2>
      <p>{t('terms.s2.p1')}</p>

      <h2>{t('terms.s3.h')}</h2>
      <p>{t('terms.s3.p1')}</p>

      <h2>{t('terms.s4.h')}</h2>
      <p>{t('terms.s4.p1')}</p>

      <h2>{t('terms.s5.h')}</h2>
      <p>{t('terms.s5.p1')} <a href={privacyPath}>{t('terms.s5.privacyLink')}</a>。</p>

      <h2>{t('terms.s6.h')}</h2>
      <p>{t('terms.s6.p1')}</p>
      <p>{t('terms.s6.p2')}</p>
      <p>{t('terms.s6.p3')}</p>
      <p>{t('terms.s6.p4')}</p>

      <h2>{t('terms.s7.h')}</h2>
      <p>{t('terms.s7.p1')}</p>

      <h2>{t('terms.s8.h')}</h2>
      <p>{t('terms.s8.p1')}</p>

      <h2>{t('terms.s9.h')}</h2>
      <p>{t('terms.s9.p1')}</p>

      <h2>{t('terms.s10.h')}</h2>
      <p>{t('terms.s10.p1')}</p>

      <h2>{t('terms.s11.h')}</h2>
      <p>{t('terms.s11.p1')}</p>

      <h2>{t('terms.s12.h')}</h2>
      <p>{t('terms.s12.p1')} <a href="mailto:mogoostudio@outlook.com">mogoostudio@outlook.com</a>。</p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 72px 40px 56px;
    text-align: center;
    background: #f8f8f8;
  }

  .page-title {
    font-size: clamp(36px, 6vw, 56px);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #222;
    margin-bottom: 12px;
  }

  .updated {
    font-family: "Nunito", sans-serif;
    font-size: 13px;
    color: #999;
  }

  .legal-body {
    max-width: 760px;
    margin: 0 auto;
    padding: 56px 40px 80px;
  }

  .legal-body h2 {
    font-size: 20px;
    font-weight: 800;
    color: #222;
    margin-top: 40px;
    margin-bottom: 12px;
  }

  .legal-body h2:first-child { margin-top: 0; }

  .legal-body p,
  .legal-body li {
    font-family: "Nunito", sans-serif;
    font-size: 14.5px;
    color: #555;
    line-height: 1.8;
  }

  .legal-body a { color: #F2455C; }
  .legal-body a:hover { text-decoration: underline; }

  @media (max-width: 640px) {
    .legal-body { padding: 40px 24px 60px; }
  }
</style>
