---
import '../styles/motion-studies.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>滚动研究 · MogooStudio</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="motion-studio">
      <aside class="study-sidebar" aria-label="方案选择">
        <a class="study-brand" href="/zh-cn/" target="_blank" rel="noopener"><span>M</span> MogooStudio <small>STUDIES / 02</small></a>
        <div class="study-intro"><p class="eyebrow">MOTION YOU CAN SEE.</p><h1>让运动<br />看得见。</h1><p class="study-lede">第二轮，三种明确的运动方式。<br />整卡、图文、层叠，各走一条路。</p></div>

        <div class="direction-list" role="group" aria-label="切换滚动方案">
          <button class="direction" data-mode="depth" aria-pressed="true"><span class="direction-letter">A</span><span><strong>整卡推近</strong><small>整张卡片，从远处推到眼前。</small></span><span class="direction-arrow" aria-hidden="true">↗</span></button>
          <button class="direction" data-mode="split" aria-pressed="false"><span class="direction-letter">B</span><span><strong>图文对向入场</strong><small>图片与文字，从两边汇合。</small></span><span class="direction-arrow" aria-hidden="true">↗</span></button>
          <button class="direction" data-mode="stack" aria-pressed="false"><span class="direction-letter">C</span><span><strong>叠卡交接</strong><small>下一张盖上来，前一张退后。</small></span><span class="direction-arrow" aria-hidden="true">↗</span></button>
        </div>

        <section class="direction-notes" aria-labelledby="direction-name"><p class="eyebrow" data-direction-label>A / CARDS COME CLOSER</p><h2 id="direction-name">卡片从远处推到眼前。</h2><p data-direction-description>整张产品卡由小变大、向上推近，带一点立体倾角。滚动多少，就推进多少；进入阅读位置后完全展开。</p><dl><div><dt>节奏</dt><dd data-direction-timing>缩放 82% → 100% · 上移 96px</dd></div><div><dt>取舍</dt><dd data-direction-cost>运动直接、连贯；回滚时会退回。</dd></div></dl></section>

        <div class="sidebar-bottom"><button class="baseline-button" data-mode="static" aria-pressed="false"><span aria-hidden="true">○</span> 静态基线 <kbd>0</kbd></button><p>首屏自然滚动 · 无遮罩揭幕<br />遵循系统减少动态效果</p></div>
      </aside>

      <section class="study-workspace" aria-label="实际页面预览">
        <header class="preview-toolbar">
          <div class="preview-title"><span class="live-dot" aria-hidden="true"></span><strong>真实首页</strong><span data-current-direction>整卡推近</span></div>
          <div class="preview-controls">
            <label class="language-control"><span class="visually-hidden">预览语言</span><select id="study-language"><option value="zh-cn">简体中文</option><option value="en">English</option><option value="zh-tw">繁體中文</option></select></label>
            <div class="device-switch" role="group" aria-label="预览宽度"><button data-device="desktop" aria-pressed="true">宽屏</button><button data-device="mobile" aria-pressed="false">手机</button></div>
            <button class="replay-button" data-replay title="重新加载本方案">↺ <span>重播</span></button>
          </div>
        </header>

        <div class="preview-stage" data-device="desktop"><iframe id="study-preview" src="/zh-cn/?motion-study=depth" title="MogooStudio 首页滚动方案预览"></iframe></div>

        <footer class="preview-footer"><div><p class="preview-status" role="status">正在载入首页…</p><small>直接滚动预览区 · 产品图、分类和小程序码均可操作</small></div><button class="demo-button" data-demo aria-pressed="false"><span aria-hidden="true">▶</span> 播放滚动演示</button></footer>
      </section>
    </main>
    <script>
      import { initializeMotionStudies } from '../scripts/motion-studies';
      initializeMotionStudies();
    </script>
  </body>
</html>
