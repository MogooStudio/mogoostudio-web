---
import '../styles/playground.css';
import '../styles/studio-pages.css';
import { homeCopy } from '../i18n/home';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath, getPathWithoutLocale } from '../i18n/utils';
import { languages, localeMetadata, type Locale } from '../i18n/locales';

interface Props {
  title: string;
  description?: string;
  rawTitle?: boolean;
  playground?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description = t('meta.index'), rawTitle = false, playground = true } = Astro.props;
const pageTitle = rawTitle ? title : `${title} | MogooStudio`;
const htmlLang = localeMetadata[lang].html;

const pathWithoutLocale = getPathWithoutLocale(Astro.url.pathname);
const locales = Object.keys(languages) as Locale[];
const canonicalUrl = new URL(getLocalizedPath(pathWithoutLocale, lang), Astro.site).toString();
---

<!DOCTYPE html>
<html lang={htmlLang}>
<head>
  <meta charset="UTF-8" />
  {import.meta.env.PROD && <>
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-MTMZ554B"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
  </>}
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{pageTitle}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalUrl} />
  {locales.map((code) => (
    <link rel="alternate" hreflang={localeMetadata[code].hreflang} href={new URL(getLocalizedPath(pathWithoutLocale, code), Astro.site)} />
  ))}
  <link rel="alternate" hreflang="x-default" href={new URL(pathWithoutLocale, Astro.site)} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="MogooStudio" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content={localeMetadata[lang].og} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  {playground ? <>
    <link rel="preload" href="/fonts/nunito-900.ttf" as="font" type="font/ttf" crossorigin />
    {lang.startsWith('zh-') && <link rel="preload" href="/fonts/playground-display.woff2" as="font" type="font/woff2" crossorigin />}
  </> : <>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  </>}
</head>
<body class:list={{ playground }}>
  <a class="skip-link" href="#main">{homeCopy[lang].skip}</a>
  <Nav currentLang={lang} playground={playground} />
  <slot />
  <Footer currentLang={lang} playground={playground} />
</body>
</html>

<style is:global>
  :root {
    --red: #F2455C;
    --teal: #29C4D9;
    --yellow: #FFC93C;
    --dark: #181818;
    --text: #222;
    --muted: #666;
    --border: #eee;
    --bg-light: #f8f8f8;
    --nav-h: 72px;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: "Nunito", "Segoe UI Rounded", sans-serif;
    color: var(--text);
    background: #fff;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    padding-top: var(--nav-h);
  }

  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; }
</style>
