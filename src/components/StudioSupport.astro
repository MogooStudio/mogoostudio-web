---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { homeCopy } from '../i18n/home';
import { studioCopy } from '../i18n/studio';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const copy = studioCopy[lang];
const answerParts = t('support.faq.a1').split('support@mogoostudio.com');
const questions = [
  { q: t('support.faq.q1'), a: t('support.faq.a1') },
  { q: copy.faq2, a: copy.answer2 },
  { q: t('support.faq.q3'), a: t('support.faq.a3') },
  { q: t('support.faq.q4'), a: t('support.faq.a4') },
];
---
<BaseLayout title={homeCopy[lang].support} description={copy.supportIntro}>
  <main id="main" class="studio-page support-page">
    <header class="inner-hero">
      <p class="section-label">{copy.supportLabel}</p>
      <h1>{copy.supportTitle.map(line => <span>{line}</span>)}</h1>
      <p class="inner-intro">{copy.supportIntro}</p>
      <a class="gallery-action" href="mailto:support@mogoostudio.com">{copy.email} <span aria-hidden="true">↗</span></a>
    </header>
    <section class="studio-faq" aria-labelledby="faq-title">
      <h2 id="faq-title">{t('support.faq.title')}</h2>
      {questions.map((item, index) => <details class="studio-question" open={index === 0}>
        <summary>{item.q}<span aria-hidden="true" class="faq-toggle"></span></summary>
        <div class="studio-answer"><p>{index === 0 && answerParts.length > 1 ? <>{answerParts[0]}<a href="mailto:support@mogoostudio.com">support@mogoostudio.com</a>{answerParts[1]}</> : item.a}</p></div>
      </details>)}
    </section>
    <aside class="support-note section-rule">
      <h2>{copy.reportTitle}</h2>
      <ol>{copy.reportItems.map(item => <li>{item}</li>)}</ol>
      <a class="text-link" href="mailto:support@mogoostudio.com">support@mogoostudio.com <span aria-hidden="true">↗</span></a>
    </aside>
  </main>
</BaseLayout>

<style>
  .support-page {
    display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1fr);
    grid-template-areas: 'intro faq' 'note faq';
    gap: clamp(40px, 5vw, 72px) clamp(40px, 8vw, 130px);
    align-items: start;
  }
  .support-page .inner-hero { grid-area: intro; margin-bottom: 0; }
  .section-label { color: var(--gallery-muted); font-size: 13px; letter-spacing: .09em; margin-bottom: 20px; }
  .studio-faq { grid-area: faq; min-width: 0; }
  .studio-faq h2 { font-size: clamp(26px, 2.7vw, 40px); font-weight: 500; letter-spacing: -.035em; margin: 0 0 24px; }
  .studio-question { border-bottom: 1px solid var(--gallery-line); }
  .studio-question:first-of-type { border-top: 1px solid var(--gallery-line); }
  .studio-question summary {
    display: flex; align-items: center; justify-content: space-between;
    gap: 20px; list-style: none; padding: 23px 0;
    font-size: clamp(16px, 1.3vw, 20px); line-height: 1.5; cursor: pointer;
  }
  .studio-question summary::-webkit-details-marker { display: none; }
  .studio-question summary:hover, .studio-question[open] summary { color: var(--gallery-gold); }
  .faq-toggle { position: relative; flex: none; display: inline-block; width: 16px; height: 16px; color: var(--gallery-gold); }
  .faq-toggle::before, .faq-toggle::after {
    content: ''; position: absolute; top: 50%; left: 0;
    width: 100%; height: 1px; background: currentColor;
  }
  .faq-toggle::after { transform: rotate(90deg); }
  .studio-question[open] .faq-toggle::after { display: none; }
  .studio-answer { color: var(--gallery-muted); font-size: 16px; line-height: 1.85; padding: 0 35px 24px 0; overflow-wrap: anywhere; }
  .studio-answer a { color: var(--gallery-text); text-decoration: underline; text-underline-offset: .23em; }
  .support-note { grid-area: note; }
  .support-note h2 { max-width: 28ch; font-size: clamp(21px, 1.8vw, 28px); line-height: 1.4; font-weight: 500; }
  .support-note ol { padding-left: 1.75em; margin-block: 20px; }
  .support-note li { color: var(--gallery-muted); font-size: 15px; line-height: 1.75; padding-left: .4em; }
  .support-note li + li { margin-top: 6px; }
  .support-note li::marker { color: var(--gallery-gold); font-family: Consolas, monospace; }
  .support-note .text-link { overflow-wrap: anywhere; }
  @media (max-width: 760px) {
    .support-page { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'intro' 'faq' 'note'; gap: 42px; }
    .section-label { margin-bottom: 12px; }
    .studio-faq h2 { margin-bottom: 16px; }
    .studio-question summary { padding: 18px 0; }
    .studio-answer { font-size: 15px; padding: 0 12px 18px 0; }
  }
</style>
