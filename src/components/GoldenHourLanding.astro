---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { goldenHourCopy } from '../i18n/golden-hour';
import { getLangFromUrl, getLocalizedPath } from '../i18n/utils';
import dashboardDemo from '../assets/golden-hour/dashboard-demo.png';
import mobileDemo from '../assets/golden-hour/dashboard-mobile.png';
import monthlyDemo from '../assets/golden-hour/monthly-demo.png';
import monthlyMobile from '../assets/golden-hour/monthly-mobile.png';
import yearlyDemo from '../assets/golden-hour/yearly-demo.png';
import yearlyMobile from '../assets/golden-hour/yearly-mobile.png';

const locale = getLangFromUrl(Astro.url);
const copy = goldenHourCopy[locale];
const productUrl = 'https://hour.mogoostudio.com/';
const mobileMedia = '(max-width: 767px), (max-height: 500px) and (orientation: landscape) and (pointer: coarse)';
const [mobileDashboard, mobileCalendar, mobileAnnual] = await Promise.all(
  [mobileDemo, monthlyMobile, yearlyMobile].map(src => getImage({ src, format: 'webp', quality: 90 })),
);
const reports = [
  { ...copy.monthly, image: monthlyDemo, mobile: mobileCalendar },
  { ...copy.yearly, image: yearlyDemo, mobile: mobileAnnual },
];
---

<BaseLayout title={copy.metaTitle} description={copy.metaDescription} rawTitle>
  <main id="main" class="studio-page golden-hour-page">
    <section class="golden-hero" aria-labelledby="golden-title">
      <header>
        <p class="golden-brand">{copy.brand}</p>
        <h1 id="golden-title">{copy.title}</h1>
        <p class="golden-lead">{copy.intro}</p>
        <div class="golden-actions">
          <a class="gallery-action" href={productUrl} target="_blank" rel="noopener noreferrer">{copy.open}<span aria-hidden="true">↗</span></a>
          <p>{copy.free}</p>
        </div>
      </header>
      <figure class="golden-hero-visual">
        <figcaption class="golden-image-label"><strong>{copy.dashboard}</strong><span>{copy.demo}</span></figcaption>
        <div class="golden-display">
          <a class="golden-frame golden-zoom" href={dashboardDemo.src} target="_blank" rel="noopener noreferrer">
            <picture>
              <source media={mobileMedia} srcset={mobileDashboard.src} width={mobileDashboard.attributes.width} height={mobileDashboard.attributes.height} type="image/webp" />
              <Image
                src={dashboardDemo}
                alt={copy.dashboardAlt}
                widths={[720, 1080, 1440]}
                sizes="(max-width: 900px) 80vw, 860px"
                format="webp"
                quality={90}
                loading="eager"
                fetchpriority="high"
              />
            </picture>
          </a>
        </div>
      </figure>
    </section>

    <section id="free-features" class="golden-section" aria-labelledby="golden-features-title">
      <header class="golden-section-heading">
        <h2 id="golden-features-title">{copy.features.title}</h2>
      </header>
      <ul class="golden-feature-list" role="list">
        {copy.features.items.map(item => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="golden-section" aria-labelledby="preview-title">
      <header class="golden-section-heading">
        <div>
          <h2 id="preview-title">{copy.reports}</h2>
          <p>{copy.shareNote}</p>
        </div>
        <small>{copy.demo}</small>
      </header>
      <div class="golden-report-grid">
        {reports.map(report => (
          <figure class="golden-report">
            <figcaption>
              <h3>{report.title}</h3>
              <p>{report.description}</p>
            </figcaption>
            <a class="golden-frame golden-zoom" href={report.image.src} target="_blank" rel="noopener noreferrer" aria-label={report.preview}>
              <picture>
                <source media={mobileMedia} srcset={report.mobile.src} width={report.mobile.attributes.width} height={report.mobile.attributes.height} type="image/webp" />
                <Image
                  src={report.image}
                  alt={report.alt}
                  widths={[400, 600, 1000]}
                  sizes="(max-width: 1124px) 46vw, 518px"
                  format="webp"
                  quality={88}
                  loading="lazy"
                />
              </picture>
              <span class="golden-zoom-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none">
                  <path d="M9 4H4v5m11-5h5v5M4 15v5h5m11-5v5h-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </span>
            </a>
          </figure>
        ))}
      </div>
    </section>

    <div class="golden-section golden-guide">
      <section id="golden-browser-title" aria-labelledby="browser-title">
        <h2 id="browser-title">{copy.browser.title}</h2>
        <p>{copy.browser.floating}</p>
        <p>{copy.browser.install}</p>
      </section>
      <section id="golden-privacy-title" aria-labelledby="privacy-title">
        <h2 id="privacy-title">{copy.data.title}</h2>
        <p>{copy.privacyNote}</p>
        <p>{copy.data.backup}</p>
        <p>{copy.data.analytics}</p>
        <a href={getLocalizedPath('/privacy', locale)}>{copy.data.policy}</a>
      </section>
    </div>

    <section class="golden-notes" aria-labelledby="golden-notes-title">
      <div>
        <h2 id="golden-notes-title">{copy.notes}</h2>
        <p>{copy.estimateNote}</p>
      </div>
      <a class="gallery-action" href={productUrl} target="_blank" rel="noopener noreferrer">{copy.open}<span aria-hidden="true">↗</span></a>
    </section>
  </main>
</BaseLayout>

<style>
  .golden-hour-page {
    --section-gap: clamp(48px, 6.3vw, 90px);
    max-width: 1180px;
  }
  .golden-hero header { text-align: center; }
  .golden-brand {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    color: var(--gallery-gold);
    font: italic 22px/1.35 Georgia, 'Times New Roman', serif;
  }
  .golden-brand::before, .golden-brand::after { content: ''; height: 1px; width: 32px; background: var(--gallery-line); }
  .golden-hero h1 {
    max-width: 21ch;
    margin: 12px auto 0;
    font-size: clamp(40px, 4.7vw, 72px);
    font-weight: 500;
    letter-spacing: -.045em;
    line-height: 1.14;
    text-wrap: balance;
  }
  .golden-lead { margin: 16px auto 0; color: var(--gallery-muted); font-size: 17px; line-height: 1.7; text-wrap: balance; }
  .golden-actions { display: flex; justify-content: center; align-items: center; gap: 18px; flex-wrap: wrap; margin-top: 24px; }
  .golden-actions p, .golden-section-heading small { font-size: 13px; color: var(--gallery-muted); }
  .golden-hour-page .gallery-action { margin: 0; }
  .golden-hero-visual { margin-top: clamp(28px, 3vw, 46px); }
  .golden-image-label, .golden-section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
  }
  .golden-image-label { margin-bottom: 10px; font-size: 12px; color: var(--gallery-muted); }
  .golden-image-label strong { color: var(--gallery-text); font-weight: 500; }
  .golden-display {
    display: grid;
    justify-items: center;
    border: 1px solid var(--gallery-line);
    padding: clamp(20px, 4.3vw, 64px);
    background: var(--gallery-surface) url('../assets/home/golden-dial.webp') center / cover no-repeat;
  }
  .golden-frame {
    display: block;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--gallery-line);
    background: var(--gallery-bg);
  }
  .golden-display .golden-frame { width: min(100%, 860px); box-shadow: 0 18px 45px #0009; }
  .golden-frame picture, .golden-frame img { display: block; width: 100%; height: auto; }
  .golden-zoom { cursor: zoom-in; }
  .golden-zoom:hover { border-color: var(--gallery-gold); }
  .golden-zoom-icon {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--gallery-muted);
    border-radius: 50%;
    background: var(--gallery-surface);
    color: var(--gallery-gold);
  }
  .golden-section, .golden-notes { margin-top: var(--section-gap); scroll-margin-top: 24px; }
  .golden-section-heading { margin-bottom: 24px; }
  .golden-section-heading h2, .golden-guide h2, .golden-notes h2 { font-weight: 500; letter-spacing: -.035em; line-height: 1.25; }
  .golden-section-heading h2 { font-size: clamp(28px, 3vw, 44px); }
  .golden-feature-list { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding-block: 25px; border-block: 1px solid var(--gallery-line); }
  .golden-feature-list li + li { border-inline-start: 1px solid var(--gallery-line); padding-inline-start: clamp(18px, 2.5vw, 36px); }
  .golden-feature-list li:not(:last-child) { padding-inline-end: clamp(18px, 2.5vw, 36px); }
  .golden-feature-list h3, .golden-report h3 { font-size: 20px; font-weight: 500; line-height: 1.45; }
  .golden-section p, .golden-notes p { font-size: 16px; line-height: 1.75; color: var(--gallery-muted); margin-top: 8px; }
  .golden-report-grid, .golden-guide { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(20px, 3vw, 44px); }
  .golden-report figcaption { margin-bottom: 14px; }
  .golden-guide section, .golden-notes { padding-top: 24px; border-top: 1px solid var(--gallery-line); }
  .golden-guide h2, .golden-notes h2 { font-size: clamp(24px, 2vw, 32px); }
  .golden-guide a { display: inline-block; margin-top: 16px; color: var(--gallery-gold); text-decoration: underline; text-underline-offset: 4px; }
  .golden-notes { display: flex; justify-content: space-between; align-items: center; gap: 22px; }
  .golden-notes a { flex: none; }

  @media (max-width: 767px), (max-height: 500px) and (orientation: landscape) and (pointer: coarse) {
    .golden-brand { font-size: 18px; }
    .golden-hero h1 { font-size: clamp(32px, 8.6vw, 44px); }
    .golden-lead { font-size: 15px; margin-top: 12px; }
    .golden-actions { gap: 14px; margin-top: 18px; }
    .golden-display { padding: 24px 16px; }
    .golden-display .golden-frame { width: min(78%, 310px); }
    .golden-section-heading { margin-bottom: 18px; flex-wrap: wrap; }
    .golden-feature-list, .golden-report-grid, .golden-guide { grid-template-columns: minmax(0, 1fr); }
    .golden-feature-list { padding: 0; }
    .golden-feature-list li { padding-block: 16px; }
    .golden-feature-list li + li { padding-inline-start: 0; border-inline-start: none; border-top: 1px solid var(--gallery-line); }
    .golden-report-grid { gap: 32px; }
    .golden-report .golden-frame { max-width: 330px; margin-inline: auto; }
    .golden-section p, .golden-notes p { font-size: 15px; }
    .golden-notes { flex-direction: column; align-items: flex-start; }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .golden-report:not(:focus-within) {
        animation: golden-report-enter linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 50%;
      }
      @keyframes golden-report-enter { from { translate: 0 18px; } to { translate: 0 0; } }
    }
  }
</style>
