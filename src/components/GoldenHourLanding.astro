---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { goldenHourCopy } from '../i18n/golden-hour';
import { getLangFromUrl, getLocalizedPath } from '../i18n/utils';
import dashboardDemo from '../assets/golden-hour/dashboard-demo.png';
import monthlyDemo from '../assets/golden-hour/monthly-demo.png';
import yearlyDemo from '../assets/golden-hour/yearly-demo.png';

const lang = getLangFromUrl(Astro.url);
const copy = goldenHourCopy[lang];
const productUrl = 'https://hour.mogoostudio.com/';
---

<BaseLayout title={copy.metaTitle} description={copy.metaDescription} rawTitle playground>
  <main id="main" class="studio-page golden-hour-page">
    <section class="golden-hero" aria-labelledby="golden-title">
      <div class="golden-hero-copy">
        <p class="golden-eyebrow">{copy.eyebrow}</p>
        <h1 id="golden-title" class="display-type">{copy.title}</h1>
        <p class="golden-lead">{copy.intro}</p>
        <div class="golden-actions">
          <a class="pill-link golden-primary" href={productUrl} target="_blank" rel="noopener noreferrer">{copy.start}<span aria-hidden="true">↗</span></a>
          <a class="golden-secondary" href="#free-features">{copy.seeFeatures}<span aria-hidden="true">↓</span></a>
        </div>
        <p class="estimate-note">{copy.estimateNote}</p>
      </div>
      <figure class="golden-hero-visual">
        <span class="demo-badge">{copy.demoLabel}</span>
        <Image src={dashboardDemo} alt={copy.dashboardAlt} widths={[640, 960, 1280, 1440]} sizes="(max-width: 767px) 92vw, 52vw" format="webp" quality={88} loading="eager" fetchpriority="high" />
        <figcaption>{copy.demoLabel} · {copy.dashboardCaption}</figcaption>
      </figure>
    </section>

    <section class="golden-section preview-section" aria-labelledby="preview-title">
      <header class="golden-section-heading">
        <p class="golden-eyebrow">{copy.demoLabel}</p>
        <h2 id="preview-title" class="display-type">{copy.previewTitle}</h2>
        <p>{copy.previewIntro}</p>
      </header>
      <div class="preview-grid">
        <figure class="preview-card preview-card-wide">
          <div class="preview-image"><Image src={dashboardDemo} alt={copy.dashboardAlt} widths={[720, 1080, 1440]} sizes="(max-width: 767px) 92vw, 78vw" format="webp" quality={88} loading="lazy" /></div>
          <figcaption><strong>{copy.demoLabel}</strong><span>{copy.dashboardCaption}</span></figcaption>
        </figure>
        <figure class="preview-card">
          <div class="preview-image"><Image src={monthlyDemo} alt={copy.monthlyAlt} widths={[520, 760, 1080]} sizes="(max-width: 767px) 92vw, 39vw" format="webp" quality={88} loading="lazy" /></div>
          <figcaption><strong>{copy.demoLabel}</strong><span>{copy.monthlyCaption}</span></figcaption>
        </figure>
        <figure class="preview-card">
          <div class="preview-image"><Image src={yearlyDemo} alt={copy.yearlyAlt} widths={[520, 760, 1080]} sizes="(max-width: 767px) 92vw, 39vw" format="webp" quality={88} loading="lazy" /></div>
          <figcaption><strong>{copy.demoLabel}</strong><span>{copy.yearlyCaption}</span></figcaption>
        </figure>
      </div>
    </section>

    <section id="free-features" class="golden-section features-section" aria-labelledby="features-title">
      <header class="golden-section-heading">
        <p class="golden-eyebrow">{copy.freeLabel}</p>
        <h2 id="features-title" class="display-type">{copy.freeTitle}</h2>
        <p>{copy.freeIntro}</p>
      </header>
      <div class="feature-grid">
        {copy.featureGroups.map((feature, index) => (
          <article class="feature-card">
            <span class="feature-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="golden-section support-section" aria-labelledby="browser-title">
      <header class="support-heading">
        <p class="golden-eyebrow">{copy.browserLabel}</p>
        <h2 id="browser-title" class="display-type">{copy.browserTitle}</h2>
        <p>{copy.browserIntro}</p>
      </header>
      <ol class="support-list">
        {copy.browserItems.map((item, index) => <li><span>{index + 1}</span><p>{item}</p></li>)}
      </ol>
    </section>

    <section class="golden-section privacy-section" aria-labelledby="privacy-title">
      <div class="privacy-main">
        <p class="golden-eyebrow">{copy.privacyLabel}</p>
        <h2 id="privacy-title" class="display-type">{copy.privacyTitle}</h2>
        <p>{copy.privacyIntro}</p>
        <div class="privacy-links">
          <a class="golden-secondary" href={getLocalizedPath('/privacy/', lang)}>{copy.privacyLink}<span aria-hidden="true">→</span></a>
          <a class="golden-secondary" href={getLocalizedPath('/terms/', lang)}>{copy.termsLink}<span aria-hidden="true">→</span></a>
        </div>
      </div>
      <ul class="privacy-list">{copy.privacyItems.map(item => <li>{item}</li>)}</ul>
    </section>

    <section class="golden-section pro-section" aria-labelledby="pro-title">
      <header class="golden-section-heading">
        <p class="golden-eyebrow">{copy.proLabel}</p>
        <h2 id="pro-title" class="display-type">{copy.proTitle}</h2>
        <p>{copy.proIntro}</p>
      </header>
      <div class="pro-grid">
        {[copy.desktopPro, copy.iphoneApp].map((direction, index) => (
          <article class="pro-card">
            <span class="pro-status">{copy.proLabel}</span>
            <div class="pro-icon" aria-hidden="true">{index === 0 ? '▱' : '│'}</div>
            <h3>{direction.title}</h3>
            <p>{direction.body}</p>
            <p class="pro-candidates">{direction.candidates}</p>
            <p class="pro-note">{direction.note}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="golden-section contact-section" aria-labelledby="contact-title">
      <div>
        <p class="golden-eyebrow">{copy.contactLabel}</p>
        <h2 id="contact-title" class="display-type">{copy.contactTitle}</h2>
        <p>{copy.contactBody}</p>
      </div>
      <a class="pill-link" href="mailto:support@mogoostudio.com">{copy.email}<span aria-hidden="true">↗</span></a>
    </section>

    <section class="golden-final" aria-labelledby="final-title">
      <div class="golden-final-mark" aria-hidden="true">¥</div>
      <h2 id="final-title" class="display-type">{copy.finalTitle}</h2>
      <p>{copy.finalBody}</p>
      <a class="pill-link golden-primary" href={productUrl} target="_blank" rel="noopener noreferrer">{copy.finalCta}<span aria-hidden="true">↗</span></a>
    </section>
  </main>
</BaseLayout>

<style>
  .golden-hour-page{--gold:#c99b3d;--gold-bright:#e9c77c;--gold-pale:#fff4d8;--gold-ink:#6f4e11;max-width:1240px;padding-bottom:96px}
  .golden-hero{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:52px;align-items:center;padding:70px 0 84px}
  .golden-hero-copy{min-width:0}.golden-eyebrow{font-size:12px;font-weight:900;letter-spacing:.16em;text-transform:uppercase;color:var(--gold-ink);margin:0 0 18px}
  .golden-hero h1{font-size:clamp(46px,5.4vw,76px);line-height:1.08;letter-spacing:-.045em;text-wrap:balance}.golden-lead{font-size:18px;line-height:1.8;color:#4d4e53;margin:25px 0 0;max-width:610px}
  .golden-actions{display:flex;align-items:center;flex-wrap:wrap;gap:18px;margin-top:30px}.golden-primary{background:#171612;color:#ffe4a2}.golden-primary:hover{background:#2b281f;color:#fff0c7}
  .golden-secondary{display:inline-flex;align-items:center;gap:10px;color:#6f4e11;font-weight:900;text-decoration:underline;text-underline-offset:6px;text-decoration-thickness:1px}.golden-secondary:hover{color:#a5263e}
  .estimate-note{font-size:13px;line-height:1.75;color:#6b665c;margin-top:25px;padding-left:15px;border-left:3px solid var(--gold-bright)}
  .golden-hero-visual{position:relative;min-width:0;margin:0;padding:18px;border-radius:28px;background:linear-gradient(145deg,#fff1c8,#e7bb62);box-shadow:0 26px 60px rgba(95,69,18,.18);transform:rotate(1.2deg)}
  .golden-hero-visual img{width:100%;border-radius:17px;border:1px solid rgba(71,48,9,.2)}.golden-hero-visual figcaption{font-size:12px;line-height:1.6;color:#5a431d;padding:13px 4px 0}
  .demo-badge{position:absolute;z-index:1;top:31px;left:31px;border-radius:99px;background:#fffcf6;color:#65470d;padding:8px 12px;font-size:11px;font-weight:900;box-shadow:0 8px 20px rgba(0,0,0,.14)}
  .golden-section{padding:82px 0;border-top:1px solid #e8dfcf}.golden-section-heading{max-width:780px;margin:0 auto 38px;text-align:center}.golden-section-heading h2,.support-heading h2,.privacy-main h2,.contact-section h2{font-size:clamp(35px,4.3vw,56px);line-height:1.18;letter-spacing:-.035em;text-wrap:balance}.golden-section-heading>p:last-child,.support-heading>p:last-child,.privacy-main>p,.contact-section>div>p:last-child{font-size:16px;line-height:1.85;color:#57585e;margin-top:18px}
  .preview-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.preview-card{margin:0;border:1px solid #eadfca;border-radius:25px;overflow:hidden;background:#fffaf0}.preview-card-wide{grid-column:1/-1}.preview-image{overflow:hidden;background:#171612}.preview-card img{width:100%;transition:transform .35s ease}.preview-card:hover img{transform:scale(1.012)}.preview-card figcaption{display:flex;align-items:flex-start;gap:13px;padding:18px 20px;font-size:13px;line-height:1.65;color:#57524a}.preview-card figcaption strong{flex:none;border-radius:99px;background:#f2d899;color:#5d4310;padding:4px 9px;font-size:11px}
  .feature-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.feature-card{position:relative;min-width:0;border-radius:23px;background:#fff4d8;padding:28px}.feature-card:nth-child(2),.feature-card:nth-child(5){background:#e4f6f6}.feature-card:nth-child(3),.feature-card:nth-child(6){background:#ffe5e3}.feature-number{display:block;font-size:12px;font-weight:900;color:#9d762d;letter-spacing:.08em;margin-bottom:28px}.feature-card h3{font-size:21px;line-height:1.35;margin-bottom:10px}.feature-card p{font-size:14px;line-height:1.8;color:#505157}
  .support-section{display:grid;grid-template-columns:minmax(0,.78fr) minmax(0,1.22fr);gap:58px;align-items:start}.support-heading{position:sticky;top:100px}.support-list{list-style:none;padding:0;display:grid;gap:12px}.support-list li{display:grid;grid-template-columns:42px minmax(0,1fr);gap:16px;align-items:start;padding:21px 22px;border:1px solid #e8dfcf;border-radius:19px;background:#fff}.support-list li>span{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:#f4d98f;color:#5e430d;font-weight:900}.support-list p{font-size:14px;line-height:1.75;color:#4f5055}
  .privacy-section{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:54px;align-items:start;background:#fff2df;border:0;border-radius:30px;padding:50px;margin-top:30px}.privacy-links{display:flex;flex-wrap:wrap;gap:20px;margin-top:28px}.privacy-list{list-style:none;padding:0;display:grid;gap:13px}.privacy-list li{position:relative;border-radius:18px;background:rgba(255,255,255,.72);padding:19px 20px 19px 47px;font-size:14px;line-height:1.75;color:#4d4e53}.privacy-list li::before{content:'✓';position:absolute;left:20px;color:#a36f16;font-weight:900}
  .pro-section{border-top:0}.pro-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.pro-card{position:relative;border-radius:26px;border:1px solid #dfc482;background:#fffaf0;padding:30px;min-width:0}.pro-status{display:inline-block;border-radius:99px;background:#f1d898;color:#62450d;font-size:11px;font-weight:900;padding:7px 11px;margin-bottom:22px}.pro-icon{font-size:42px;line-height:1;color:#b8872d;margin-bottom:18px}.pro-card h3{font-size:26px;line-height:1.35;margin-bottom:11px}.pro-card p{font-size:14px;line-height:1.8;color:#515258;margin-top:9px}.pro-card .pro-candidates{font-weight:800;color:#5f481c}.pro-card .pro-note{border-top:1px solid #e5d8bc;padding-top:14px;margin-top:18px}
  .contact-section{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:40px;align-items:center}.contact-section>div{max-width:760px}.contact-section .pill-link{max-width:360px;text-align:center}
  .golden-final{text-align:center;border-radius:32px;background:#171612;color:#fff8e9;padding:64px 28px}.golden-final-mark{display:grid;place-items:center;width:72px;height:72px;border:1px solid #e9c77c;border-radius:50%;color:#e9c77c;font-size:36px;font-weight:900;margin:0 auto 24px}.golden-final h2{font-size:clamp(39px,5vw,64px);line-height:1.12}.golden-final p{max-width:620px;margin:18px auto 27px;color:#d9d0bf;line-height:1.8}.golden-final .golden-primary{background:#e9c77c;color:#251c0c}.golden-final .golden-primary:hover{background:#f6dfac;color:#251c0c}
  @media(max-width:900px){.golden-hero{grid-template-columns:1fr;gap:38px;padding-top:50px}.golden-hero-copy{text-align:center}.golden-lead,.estimate-note{margin-left:auto;margin-right:auto}.golden-actions{justify-content:center}.feature-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.support-section,.privacy-section{grid-template-columns:1fr}.support-heading{position:static}.contact-section{grid-template-columns:1fr}.contact-section .pill-link{justify-self:start}.golden-hero-visual{transform:none}}
  @media(max-width:767px){.golden-hour-page{padding-left:18px;padding-right:18px;padding-bottom:56px}.golden-hero{padding:35px 0 58px}.golden-hero h1{font-size:clamp(39px,12vw,58px)}.golden-lead{font-size:16px}.golden-actions{flex-direction:column;align-items:stretch}.golden-actions .pill-link,.golden-actions .golden-secondary{justify-content:center}.golden-hero-visual{padding:9px;border-radius:20px}.golden-hero-visual img{border-radius:13px}.demo-badge{top:18px;left:18px}.golden-hero-visual figcaption{font-size:11px}.golden-section{padding:58px 0}.golden-section-heading{margin-bottom:28px}.preview-grid,.feature-grid,.pro-grid{grid-template-columns:1fr}.preview-card-wide{grid-column:auto}.preview-card{border-radius:20px}.preview-card figcaption{flex-direction:column}.feature-card{padding:24px}.support-section{gap:28px}.support-list li{grid-template-columns:34px minmax(0,1fr);padding:18px;gap:12px}.support-list li>span{width:32px;height:32px;font-size:13px}.privacy-section{padding:30px 22px;margin-top:14px;border-radius:24px;gap:30px}.privacy-links{flex-direction:column;align-items:flex-start}.pro-card{padding:25px 22px}.contact-section{gap:26px}.contact-section .pill-link{width:100%;max-width:none}.golden-final{border-radius:25px;padding:48px 20px}}
  @media(prefers-reduced-motion:reduce){.preview-card img{transition:none}}
</style>
