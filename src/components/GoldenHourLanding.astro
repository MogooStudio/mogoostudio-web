---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { goldenHourCopy } from '../i18n/golden-hour';
import { getLangFromUrl, getLocalizedPath } from '../i18n/utils';
import dashboardDemo from '../assets/golden-hour/dashboard-demo.png';
import mobileDemo from '../assets/golden-hour/dashboard-mobile.png';
import monthlyDemo from '../assets/golden-hour/monthly-demo.png';
import monthlyMobile from '../assets/golden-hour/monthly-mobile.png';
import yearlyDemo from '../assets/golden-hour/yearly-demo.png';
import yearlyMobile from '../assets/golden-hour/yearly-mobile.png';

const locale = getLangFromUrl(Astro.url);
const copy = goldenHourCopy[locale];
const productUrl = 'https://hour.mogoostudio.com/';
const mobileMedia = '(max-width: 767px), (max-width: 960px) and (max-height: 500px) and (orientation: landscape) and (pointer: coarse)';
const [mobileDashboard, mobileCalendar, mobileAnnual] = await Promise.all(
  [mobileDemo, monthlyMobile, yearlyMobile].map(src => getImage({ src, format: 'webp', quality: 90 })),
);
const reports = [
  { ...copy.monthly, image: monthlyDemo, mobile: mobileCalendar },
  { ...copy.yearly, image: yearlyDemo, mobile: mobileAnnual },
];
---

<BaseLayout title={copy.metaTitle} description={copy.metaDescription} rawTitle compactFooter>
  <main id="main" class="studio-page golden-hour-page">
    <section class="golden-hero" aria-labelledby="golden-title">
      <header>
        <p class="golden-brand">{copy.brand}</p>
        <h1 id="golden-title">{copy.title}</h1>
        <p class="golden-lead">{copy.intro}</p>
        <div class="golden-actions">
          <a class="pill-link golden-primary" href={productUrl} target="_blank" rel="noopener noreferrer">{copy.open}<span aria-hidden="true">↗</span></a>
          <p>{copy.free}</p>
        </div>
      </header>
      <figure class="golden-hero-visual">
        <figcaption class="golden-image-label"><strong>{copy.dashboard}</strong><span>{copy.demo}</span></figcaption>
        <picture class="golden-frame">
          <source media={mobileMedia} srcset={mobileDashboard.src} width={mobileDashboard.attributes.width} height={mobileDashboard.attributes.height} type="image/webp" />
          <Image
            src={dashboardDemo}
            alt={copy.dashboardAlt}
            widths={[720, 1080, 1440]}
            sizes="(max-width: 1124px) calc(100vw - 64px), 1060px"
            format="webp"
            quality={90}
            loading="eager"
            fetchpriority="high"
          />
        </picture>
      </figure>
    </section>

    <section id="free-features" class="golden-section" aria-labelledby="golden-features-title">
      <header class="golden-section-heading">
        <h2 id="golden-features-title">{copy.features.title}</h2>
      </header>
      <ul class="golden-feature-list" role="list">
        {copy.features.items.map(item => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="golden-section" aria-labelledby="preview-title">
      <header class="golden-section-heading">
        <div>
          <h2 id="preview-title">{copy.reports}</h2>
          <p>{copy.shareNote}</p>
        </div>
        <small>{copy.demo}</small>
      </header>
      <div class="golden-report-grid">
        {reports.map(report => (
          <figure class="golden-report">
            <figcaption>
              <h3>{report.title}</h3>
              <p>{report.description}</p>
            </figcaption>
            <a class="golden-frame golden-zoom" href={report.image.src} target="_blank" rel="noopener noreferrer" aria-label={report.preview}>
              <picture>
                <source media={mobileMedia} srcset={report.mobile.src} width={report.mobile.attributes.width} height={report.mobile.attributes.height} type="image/webp" />
                <Image
                  src={report.image}
                  alt={report.alt}
                  widths={[400, 600, 1000]}
                  sizes="(max-width: 1124px) 46vw, 518px"
                  format="webp"
                  quality={88}
                  loading="lazy"
                />
              </picture>
              <span class="golden-zoom-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none">
                  <path d="M9 4H4v5m11-5h5v5M4 15v5h5m11-5v5h-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </span>
            </a>
          </figure>
        ))}
      </div>
    </section>

    <div class="golden-section golden-guide">
      <section id="golden-browser-title" aria-labelledby="browser-title">
        <h2 id="browser-title">{copy.browser.title}</h2>
        <p>{copy.browser.floating}</p>
        <p>{copy.browser.install}</p>
      </section>
      <section id="golden-privacy-title" aria-labelledby="privacy-title">
        <h2 id="privacy-title">{copy.data.title}</h2>
        <p>{copy.privacyNote}</p>
        <p>{copy.data.backup}</p>
        <p>{copy.data.analytics}</p>
        <a href={getLocalizedPath('/privacy', locale)}>{copy.data.policy}</a>
      </section>
    </div>

    <section class="golden-notes" aria-labelledby="golden-notes-title">
      <div>
        <h2 id="golden-notes-title">{copy.notes}</h2>
        <p>{copy.estimateNote}</p>
      </div>
      <a class="pill-link golden-primary" href={productUrl} target="_blank" rel="noopener noreferrer">{copy.open}<span aria-hidden="true">↗</span></a>
    </section>
  </main>
</BaseLayout>

<style>
  .golden-hour-page {
    --golden-ink: #211e17;
    --golden-muted: #5f5a4f;
    --golden-accent: #6e4b11;
    --golden-highlight: #ffe8a8;
    --golden-rule: #e9e0d0;
    --golden-frame-edge: #3c3020;
    --golden-frame-radius: 16px;
    --golden-section-gap: clamp(56px, 7vw, 96px);
    --golden-content: 1060px;
    --golden-gutter: 32px;
    max-width: calc(var(--golden-content) + var(--golden-gutter) * 2);
    padding: 0 var(--golden-gutter) 60px;
    color: var(--golden-ink);
  }

  .golden-hero { padding-top: 42px; }
  .golden-hero header { text-align: center; }
  .golden-brand { color: var(--golden-accent); font-size: 14px; font-weight: 800; }
  .golden-hero h1 {
    margin: 12px auto 0;
    font-size: clamp(40px, 5.2vw, 72px);
    font-weight: 900;
    letter-spacing: -.055em;
    line-height: 1.15;
    text-wrap: balance;
  }
  .golden-lead { margin: 14px auto 0; color: var(--golden-muted); font-size: 17px; line-height: 1.55; text-wrap: pretty; }
  .golden-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 14px; margin-top: 22px; }
  .golden-actions p { color: var(--golden-muted); font-size: 13px; }
  .golden-primary {
    min-height: 48px;
    gap: 16px;
    padding: 0 21px;
    background: var(--golden-ink);
    color: var(--golden-highlight);
    font-size: 15px;
  }
  .golden-primary:hover { background: #3a3021; }

  .golden-hero-visual { margin: 25px auto 0; }
  .golden-image-label, .golden-section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 16px;
  }
  .golden-image-label { padding: 0 4px 9px; font-size: 12px; color: var(--golden-muted); }
  .golden-image-label strong { color: var(--golden-ink); }
  .golden-frame {
    display: block;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--golden-frame-edge);
    border-radius: var(--golden-frame-radius);
    background: #10100d;
  }
  .golden-frame picture { display: block; }
  .golden-frame img { width: 100%; height: auto; }
  .golden-hero-visual .golden-frame { box-shadow: 0 18px 44px #33250e1c; }

  .golden-section { margin-top: var(--golden-section-gap); scroll-margin-top: 24px; }
  .golden-section-heading { margin-bottom: 20px; }
  .golden-section-heading h2 { font-size: clamp(29px, 3.5vw, 44px); line-height: 1.2; font-weight: 900; letter-spacing: -.035em; }
  .golden-section-heading small { color: var(--golden-muted); font-size: 13px; }
  .golden-feature-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    padding-block: 22px;
    border-block: 1px solid var(--golden-rule);
  }
  .golden-feature-list li { padding-inline: 20px; }
  .golden-feature-list li:first-child { padding-inline-start: 0; }
  .golden-feature-list li:last-child { padding-inline-end: 0; }
  .golden-feature-list li + li { border-inline-start: 1px solid var(--golden-rule); }
  .golden-report-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .golden-report figcaption { margin-bottom: 12px; }
  .golden-report h3, .golden-feature-list h3 { font-size: 20px; line-height: 1.4; font-weight: 900; }
  .golden-section p, .golden-notes p { margin-top: 4px; color: var(--golden-muted); font-size: 15px; line-height: 1.65; }
  .golden-zoom { cursor: zoom-in; }
  .golden-zoom-icon {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid #ffe8a85c;
    border-radius: 8px;
    background: #211e17;
    color: var(--golden-highlight);
  }
  .golden-zoom:hover .golden-zoom-icon { background: var(--golden-highlight); color: var(--golden-ink); }
  .golden-zoom:focus-visible, .golden-primary:focus-visible, .golden-guide a:focus-visible { outline: 2px solid var(--golden-accent); outline-offset: 4px; }

  .golden-guide {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: clamp(20px, 3vw, 34px);
    background: #f7f1e5;
    border: 1px solid var(--golden-rule);
    border-radius: var(--golden-frame-radius);
  }
  .golden-guide section:first-child { padding-inline-end: 24px; }
  .golden-guide section + section { border-inline-start: 1px solid var(--golden-rule); padding-inline-start: 24px; }
  .golden-guide h2 { margin-bottom: 8px; font-size: clamp(20px, 2.4vw, 28px); font-weight: 900; }
  .golden-guide a {
    display: inline-block;
    margin-top: 10px;
    color: var(--golden-accent);
    font-size: 14px;
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .golden-notes {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    margin-top: clamp(42px, 6vw, 72px);
    border-top: 1px solid var(--golden-rule);
    padding-top: 26px;
  }
  .golden-notes h2 { margin-bottom: 7px; font-size: 20px; font-weight: 900; }
  .golden-notes .pill-link { flex: none; }

  @media (max-width: 767px), (max-width: 960px) and (max-height: 500px) and (orientation: landscape) and (pointer: coarse) {
    .golden-hour-page { --golden-gutter: 20px; --golden-section-gap: 48px; padding-bottom: 36px; }
    .golden-hero { padding-top: 28px; }
    .golden-hero h1 { margin-top: 10px; font-size: clamp(27px, 8.9vw, 40px); }
    .golden-lead { margin-top: 10px; font-size: 14px; }
    .golden-actions { gap: 10px; margin-top: 16px; }
    .golden-actions p { font-size: 12px; }
    .golden-primary { min-height: 44px; font-size: 14px; }
    .golden-hero-visual { max-width: 310px; margin-top: 22px; }
    .golden-hero-visual .golden-frame { border-radius: 19px; }
    .golden-section-heading { margin-bottom: 15px; }
    .golden-feature-list { grid-template-columns: minmax(0, 1fr); padding-block: 0; }
    .golden-feature-list li { padding: 12px 0; }
    .golden-feature-list li + li { border-inline-start: 0; border-top: 1px solid var(--golden-rule); }
    .golden-report-grid { grid-template-columns: minmax(0, 520px); justify-content: center; gap: 27px; }
    .golden-report h3, .golden-feature-list h3, .golden-notes h2 { font-size: 18px; }
    .golden-section p, .golden-notes p { font-size: 14px; }
    .golden-guide { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .golden-guide section:first-child { padding-inline-end: 0; }
    .golden-guide section + section { border-inline-start: 0; border-top: 1px solid var(--golden-rule); padding: 16px 0 0; }
    .golden-notes { flex-direction: column; align-items: flex-start; }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .golden-report:not(:focus-within) {
        animation: golden-report-enter linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 50%;
      }
      @keyframes golden-report-enter {
        from { translate: 0 18px; }
        to { translate: 0 0; }
      }
    }
  }
</style>
