---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PhoneScreenshot from './PhoneScreenshot.astro';

interface Props {
  id: string;
  title: string;
  screenshots: { src: ImageMetadata; alt: string; mobileSrc?: ImageMetadata }[];
  previous: string;
  next: string;
  paired?: boolean;
  imageWidth?: number;
  phoneFrame?: boolean;
}

const { id, title, screenshots, previous, next, paired = false, imageWidth = 440, phoneFrame = false } = Astro.props;
const Slide = paired ? 'div' : 'a';
const viewportId = `carousel-${id}`;
const hasIntro = Astro.slots.has('intro');
const slides = await Promise.all(screenshots.map(async item => ({
  ...item,
  mobileImage: item.mobileSrc ? await getImage({ src: item.mobileSrc, format: 'webp', quality: 90 }) : undefined,
})));
---

<div class="product-artwork product-carousel" data-product-carousel data-carousel-intro={hasIntro ? '' : undefined} role="group" aria-label={title}>
  <div id={viewportId} class="carousel-viewport phone-art phone-art-screenshot">
    {slides.map((item, index) => (
      <Slide class="carousel-slide" role={paired ? 'group' : undefined} href={paired ? undefined : item.src.src}
        aria-haspopup={paired ? undefined : 'dialog'} aria-controls={paired ? undefined : 'work-preview'}
        aria-label={`${item.alt} · ${index + 1} / ${screenshots.length}`}
        aria-hidden={index !== 0 ? 'true' : undefined} tabindex={index === 0 ? 0 : -1}>
        <span class:list={['carousel-single', { 'phone-stage': phoneFrame }]}>
          {phoneFrame ? <PhoneScreenshot src={item.src} alt={item.alt} /> : paired && item.mobileImage ? <span class="gallery-screenshot-pair">
            <img src={item.mobileImage.src} alt={item.alt} width={item.mobileImage.attributes.width} height={item.mobileImage.attributes.height} loading="lazy" />
            <Image src={item.src} alt={item.alt} width={1440} format="webp" loading="lazy" />
          </span> : item.mobileImage ? <picture>
            <source media="(max-width: 767px)" srcset={item.mobileImage.src} width={item.mobileImage.attributes.width} height={item.mobileImage.attributes.height} type="image/webp" />
            <Image src={item.src} alt={item.alt} width={1080} format="webp" loading="lazy" draggable="false" />
          </picture> : <Image src={item.src} alt={item.alt} width={imageWidth} format="webp" loading="lazy" draggable="false" />}
        </span>
        {hasIntro && index === 0 && <span class="carousel-intro" aria-hidden="true"><slot name="intro" /></span>}
      </Slide>
    ))}
  </div>
  <span class="carousel-status" aria-live="polite" aria-atomic="true">1 / {screenshots.length}</span>
  <slot name="caption" />
</div>
<button type="button" class="carousel-arrow carousel-previous" data-carousel-direction="-1" aria-label={previous} aria-controls={viewportId} hidden>
  <span class="carousel-arrow-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="m14 6-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
</button>
<button type="button" class="carousel-arrow carousel-next" data-carousel-direction="1" aria-label={next} aria-controls={viewportId} hidden>
  <span class="carousel-arrow-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="m10 6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
</button>
