---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  preview?: boolean;
}
const { src, alt, preview } = Astro.props;
---
<span class="phone-shell" data-preview-src={preview ? src.src : undefined} style={`--screen-ratio: ${src.width / src.height}`}>
  <Image src={src} alt={alt} width={Math.min(src.width, 440)} format="webp" loading="lazy" draggable="false" />
</span>

<style>
  .phone-shell {
    --rim: clamp(3px, 1.3cqh, 5px);
    --corner: clamp(10px, 5cqh, 22px);
    display: block;
    position: relative;
    box-sizing: content-box;
    width: min(var(--screen-width, 90cqw), calc(var(--screen-height, 91cqh) * var(--screen-ratio)));
    padding: var(--rim);
    border: 1px solid #85857c;
    border-radius: calc(var(--corner) + var(--rim));
    background: linear-gradient(120deg, #a9a99d, #363832 13%, #121311 38%, #4d5047 78%, #aaa99b);
    box-shadow: inset 0 0 0 1px #171815, 0 4px 9px #0007;
  }
  .phone-shell > img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--corner);
    box-shadow: 0 0 0 1px #070807;
  }
  .phone-shell::before, .phone-shell::after {
    content: '';
    position: absolute;
    width: 2px;
    border-radius: 1px;
    background: linear-gradient(#97988d, #56594f 35%, #797b70);
    pointer-events: none;
  }
  .phone-shell::before { left: -2px; top: 24%; height: 13%; }
  .phone-shell::after { right: -2px; top: 32%; height: 9%; }
</style>
