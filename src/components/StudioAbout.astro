---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, getLocalizedPath } from '../i18n/utils';
import { homeCopy } from '../i18n/home';
import { studioCopy } from '../i18n/studio';

const lang = getLangFromUrl(Astro.url);
const copy = studioCopy[lang];
const home = homeCopy[lang];
---
<BaseLayout title={home.about} description={copy.aboutLead}>
  <main id="main" class="studio-page about-page">
    <section class="studio-portrait" aria-labelledby="about-title">
      <header class="inner-hero">
        <p class="section-label">{copy.aboutLabel}</p>
        <h1 id="about-title">{copy.aboutTitle.map(line => <span>{line}</span>)}</h1>
      </header>
      <div class="identity-print" aria-hidden="true"><img class="studio-mark" src="/favicon.svg" alt="" width="64" height="64" /></div>
      <div class="story-copy">
        <p class="story-lead">{copy.aboutLead}</p>
        <p>{copy.aboutBody}</p>
        <p>{copy.aboutNote}</p>
        <a class="gallery-action" href={getLocalizedPath('/#works', lang)}>{home.explore} <span aria-hidden="true">↗</span></a>
      </div>
    </section>
    <section class="principles section-rule" aria-labelledby="principles-title">
      <h2 id="principles-title">{home.philosophy}</h2>
      <dl>
        {home.values.map(value => <div><dt>{value.title}</dt><dd>{value.body}</dd></div>)}
      </dl>
    </section>
    <section class="contact section-rule">
      <div><h2>{copy.contactTitle}</h2><p>{copy.contactBody}</p></div>
      <a class="text-link" href="mailto:support@mogoostudio.com">support@mogoostudio.com <span aria-hidden="true">↗</span></a>
    </section>
  </main>
</BaseLayout>

<style>
  .studio-portrait {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    grid-template-areas: 'title art' 'story art';
    gap: 28px clamp(40px, 6vw, 112px);
    align-items: center;
  }
  .studio-portrait .inner-hero { grid-area: title; align-self: end; margin-bottom: 0; }
  .section-label { margin-bottom: 20px; color: var(--gallery-muted); font-size: 13px; letter-spacing: .09em; }
  .story-copy { grid-area: story; align-self: start; max-width: 57ch; }
  .story-copy p, .principles dd, .contact p { color: var(--gallery-muted); font-size: 16px; line-height: 1.8; }
  .story-copy .story-lead { color: var(--gallery-text); font-size: clamp(17px, 1.32vw, 21px); }
  .story-copy p + p { margin-top: 12px; }

  .identity-print {
    grid-area: art;
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
    min-height: 100%;
    aspect-ratio: 1.32;
    border: 1px solid var(--gallery-line);
    background: radial-gradient(ellipse at 28% 8%, #3b3a2f 0%, #262820 32%, #191c18 65%, #111411 100%);
  }
  .identity-print::before {
    content: '';
    position: absolute; inset: 0;
    background: repeating-linear-gradient(111deg, transparent 0 2px, #0205021a 2px 3px);
  }
  .studio-mark { position: relative; width: 57%; height: auto; }
  .principles, .contact { margin-top: clamp(52px, 6vw, 92px); }
  .about-page h2 { font-size: clamp(24px, 2.5vw, 36px); font-weight: 500; letter-spacing: -.035em; }
  .principles dl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; margin-top: 28px; }
  .principles dl > div { padding-right: 28px; }
  .principles dl > div + div { border-left: 1px solid var(--gallery-line); padding-left: clamp(24px, 3vw, 48px); }
  .principles dt { color: var(--gallery-gold); font-size: 19px; }
  .principles dd, .contact p { margin-top: 8px; }
  .contact { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 16px 32px; }
  .contact a { overflow-wrap: anywhere; }
  @media (max-width: 760px) {
    .studio-portrait { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'title' 'art' 'story'; gap: 23px; }
    .section-label { margin-bottom: 12px; }
    .identity-print { min-height: 0; aspect-ratio: 1.9; }
    .studio-mark { width: 36%; }
    .principles dl { grid-template-columns: 1fr; margin-top: 10px; }
    .principles dl > div, .principles dl > div + div { border-left: none; padding: 14px 0; }
    .principles dl > div + div { border-top: 1px solid var(--gallery-line); }
    .principles dd { margin-top: 4px; }
    .story-copy p, .principles dd, .contact p { font-size: 15px; }
  }
</style>
