---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/playground.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import GoldenHourFeature from './GoldenHourFeature.astro';
import AppStoreLink from './AppStoreLink.astro';
import ProductCarousel from './ProductCarousel.astro';
import PhoneScreenshot from './PhoneScreenshot.astro';
import WorkTabs from './WorkTabs.astro';
import { getLangFromUrl } from '../i18n/utils';
import { galleryCopy, homeCopy } from '../i18n/home';
import youcanupIcon from '../assets/youcanup/icon.png';
import youcanupMenu from '../assets/youcanup/menu.png';
import youcanupGameplay from '../assets/youcanup/gameplay.png';
import youcanupAim from '../assets/youcanup/aim.png';
import youcanupCharge from '../assets/youcanup/charge.png';
import youcanupResults from '../assets/youcanup/results.png';
import youcanupOutfits from '../assets/youcanup/outfits.png';
import pinyiyeIcon from '../assets/pinyiye/icon.png';
import pinyiyeEditor from '../assets/pinyiye/editor.png';
import pinyiyeExport from '../assets/pinyiye/export.png';
import pinyiyeHome from '../assets/pinyiye/home.png';
import pinyiyeTemplates from '../assets/pinyiye/templates.png';
import pinyiyeDetail from '../assets/pinyiye/detail.png';
import pinyiyeCode from '../assets/pinyiye/wechat-code.jpg';
import codexGitIcon from '../assets/codex-git/icon.svg';
import codexGitScreenshot from '../assets/codex-git/overview.png';
import codexGitHistory from '../assets/codex-git/history-light.webp';
import codexGitDiff from '../assets/codex-git/diff-detail.webp';

const lang = getLangFromUrl(Astro.url);
const copy = homeCopy[lang];
const codexGitScreenshots = [
  { src: codexGitScreenshot, alt: copy.codexGit.screenshotAlt },
  { src: codexGitHistory, alt: copy.codexGit.historyAlt },
  { src: codexGitDiff, alt: copy.codexGit.diffAlt },
];
const screenshots = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/minimalist-breakout/*.png', { eager: true });
const games = [
  { id: 'minimalist-breakout', title: 'Minimalist Breakout', description: copy.breakout, platform: 'iOS', available: true, screenshots: Object.entries(screenshots).filter(([path]) => path.includes('/minimalist-breakout/')).sort(([a], [b]) => a.localeCompare(b)).map(([, image]) => image.default) },
];
const youcanupScreenshots = [
  { src: youcanupMenu, alt: copy.youcanup.menuAlt },
  { src: youcanupGameplay, alt: copy.youcanup.gameplayAlt },
  { src: youcanupAim, alt: copy.youcanup.aimAlt },
  { src: youcanupCharge, alt: copy.youcanup.chargeAlt },
  { src: youcanupResults, alt: copy.youcanup.resultsAlt },
  { src: youcanupOutfits, alt: copy.youcanup.outfitsAlt },
];
const pinyiyeScreenshots = [
  { src: pinyiyeEditor, alt: copy.pinyiye.editorAlt },
  { src: pinyiyeHome, alt: copy.pinyiye.homeAlt },
  { src: pinyiyeTemplates, alt: copy.pinyiye.templatesAlt },
  { src: pinyiyeDetail, alt: copy.pinyiye.detailAlt },
  { src: pinyiyeExport, alt: copy.pinyiye.exportAlt },
];
---
<BaseLayout title={copy.title} description={copy.description} rawTitle>
  <main id="main" class="gallery-shell">
    <GoldenHourFeature />
    <section id="works" class="gallery-collection" aria-labelledby="works-title">
      <div class="gallery-heading"><h2 id="works-title">{galleryCopy[lang].more}</h2></div>
      <WorkTabs labels={copy.workTabs}>
        <div id="work-results">
          <article id="youcanup" class="gallery-row catalog-row" data-category="games" aria-labelledby="youcanup-title">
            <div class="catalog-art catalog-art-imprint">
              <ProductCarousel id="youcanup" title={copy.youcanup.name} screenshots={youcanupScreenshots} previous={copy.previous} next={copy.next} phoneFrame>
                <span slot="intro" class="phone-stage phone-duo">
                  <PhoneScreenshot src={youcanupGameplay} alt="" />
                  <PhoneScreenshot src={youcanupMenu} alt="" />
                </span>
              </ProductCarousel>
            </div>
            <div class="gallery-info">
              <div class="gallery-title"><Image src={youcanupIcon} alt="" width={112} format="webp" loading="lazy" /><h3 id="youcanup-title">{copy.youcanup.name}</h3></div>
              <p>{copy.youcanup.description}</p>
              <div class="gallery-meta"><span>{copy.game} · iOS</span><span class="gallery-status">{copy.available}</span></div>
              <AppStoreLink href="https://apps.apple.com/us/app/youcanup/id6824439324" title={copy.youcanup.name} download={copy.download} />
            </div>
          </article>
          {games.map(game => (
            <article id={game.id} class="gallery-row catalog-row" data-category="games">
              <div class="catalog-art catalog-art-imprint">
                <ProductCarousel id={game.id} title={game.title} screenshots={game.screenshots.map((src, index) => ({ src, alt: `${game.title} ${index + 1}` }))} previous={copy.previous} next={copy.next} phoneFrame />
              </div>
              <div class="gallery-info">
                <h3>{game.title}</h3>
                <p>{game.description}</p>
                <div class="gallery-meta">
                  <span>{copy.game}{game.platform && ` · ${game.platform}`}</span>
                  <span class="gallery-status">{game.available ? copy.available : copy.coming}</span>
                </div>
                {game.available && <AppStoreLink href="https://apps.apple.com/us/app/minimalist-breakout/id6776583255" title={game.title} download={copy.download} />}
              </div>
            </article>
          ))}
          <article id="pinyiye" class="gallery-row catalog-row" data-category="apps" aria-labelledby="pinyiye-title">
            <div class="catalog-art catalog-art-imprint">
              <ProductCarousel id="pinyiye" title={copy.pinyiye.name} screenshots={pinyiyeScreenshots} previous={copy.previous} next={copy.next} phoneFrame>
                <span slot="intro" class="phone-stage phone-trio">
                  <PhoneScreenshot src={pinyiyeHome} alt="" />
                  <PhoneScreenshot src={pinyiyeTemplates} alt="" />
                  <PhoneScreenshot src={pinyiyeEditor} alt="" />
                </span>
              </ProductCarousel>
            </div>
            <div class="gallery-info">
              <div class="gallery-title"><Image src={pinyiyeIcon} alt="" width={112} format="webp" loading="lazy" /><h3 id="pinyiye-title">{copy.pinyiye.name}</h3></div>
              <p>{copy.pinyiye.description}</p>
              <div class="gallery-meta"><span>{copy.pinyiye.type} · {copy.pinyiye.platform}</span><span class="gallery-status">{copy.pinyiye.status}</span></div>
              <button type="button" class="gallery-action" data-mini-program aria-haspopup="dialog" aria-controls="pinyiye-code">{copy.pinyiye.open}</button>
            </div>
          </article>
          <article id="mogoo-codex-git" class="gallery-row catalog-row" data-category="apps" aria-labelledby="codex-git-title">
            <div class="catalog-art catalog-art-wide">
              <ProductCarousel id="mogoo-codex-git" title="Mogoo Codex Git" screenshots={codexGitScreenshots} previous={copy.previous} next={copy.next} imageWidth={1280} />
            </div>
            <div class="gallery-info">
              <div class="gallery-title">
                <img src={codexGitIcon.src} width="52" height="52" alt="" loading="lazy" />
                <h3 id="codex-git-title">Mogoo Codex Git</h3>
              </div>
              <p>{copy.codexGit.description}</p>
              <div class="gallery-meta">
                <span>{copy.codexGit.type} · Windows</span>
                <span class="gallery-status">{copy.codexGit.status}</span>
              </div>
              <a class="gallery-action" href="https://mogoostudio.github.io/mogoo-codex-git/" target="_blank" rel="noopener noreferrer">{copy.codexGit.website}</a>
            </div>
          </article>
        </div>
      </WorkTabs>
    </section>

  </main>
  <dialog id="pinyiye-code" class="mini-program-dialog" aria-labelledby="pinyiye-code-title" aria-describedby="pinyiye-code-hint">
    <div class="mini-program-header"><h2 id="pinyiye-code-title">{copy.pinyiye.name}</h2><button type="button" class="mini-program-close" aria-label={copy.pinyiye.closeCode} autofocus>×</button></div>
    <img class="mini-program-code" src={pinyiyeCode.src} alt={copy.pinyiye.codeAlt} width={pinyiyeCode.width} height={pinyiyeCode.height} loading="lazy" />
    <p id="pinyiye-code-hint" class="mini-program-code-hint">{copy.pinyiye.codeHint}</p>
  </dialog>
</BaseLayout>

<script>
  import { initializeProductCarousels } from '../scripts/product-carousel';
  import { initializeImprintStrings } from '../scripts/imprint-strings';

  initializeProductCarousels();
  initializeImprintStrings();

  const codeDialog = document.querySelector<HTMLDialogElement>('#pinyiye-code')!;
  const codeTrigger = document.querySelector<HTMLButtonElement>('[data-mini-program]')!;
  codeTrigger.addEventListener('click', () => {
    codeDialog.showModal();
    document.body.classList.add('mini-program-open');
  });
  codeDialog.querySelector('.mini-program-close')!.addEventListener('click', () => codeDialog.close());
  codeDialog.addEventListener('close', () => {
    document.body.classList.remove('mini-program-open');
    if (document.activeElement === document.body || codeDialog.contains(document.activeElement)) codeTrigger.focus({ preventScroll: true });
  });
  codeDialog.addEventListener('click', event => {
    if (event.target !== codeDialog) return;
    const rect = codeDialog.getBoundingClientRect();
    if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) codeDialog.close();
  });
</script>
