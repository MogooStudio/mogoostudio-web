---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import StudioValueIcon from './StudioValueIcon.astro';
import { getLangFromUrl } from '../i18n/utils';
import { homeCopy } from '../i18n/home';
import hero from '../assets/home/playground-still-life.png';
import approvedArtwork from '../assets/home/approved-artwork.png';
import youcanupIcon from '../assets/youcanup/icon.png';
import youcanupMenu from '../assets/youcanup/menu.png';
import youcanupGameplay from '../assets/youcanup/gameplay.png';
import pinyiyeIcon from '../assets/pinyiye/icon.png';
import pinyiyeEditor from '../assets/pinyiye/editor.png';
import pinyiyeExport from '../assets/pinyiye/export.png';
import pinyiyeWeekend from '../assets/pinyiye/weekend.jpg';
import pinyiyeSunshine from '../assets/pinyiye/sunshine.jpg';

const lang = getLangFromUrl(Astro.url);
const copy = homeCopy[lang];
const artwork = await getImage({ src: approvedArtwork, format: 'webp', quality: 100 });
const screenshots = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/**/*.png', { eager: true });
const games = [
  { id: 'minimalist-breakout', title: 'Minimalist Breakout', lines: ['Minimalist', 'Breakout'], description: copy.breakout, platform: 'iOS', available: true, screenshots: Object.entries(screenshots).filter(([path]) => path.includes('/minimalist-breakout/')).sort(([a], [b]) => a.localeCompare(b)).map(([, image]) => image.default) },
  { id: 'flappy-ball', title: 'Flappy Ball Hop', lines: ['Flappy', 'Ball Hop'], description: copy.flappy, platform: null, available: false, screenshots: Object.entries(screenshots).filter(([path]) => path.includes('/flappy-ball/')).sort(([a], [b]) => a.localeCompare(b)).map(([, image]) => image.default) },
];
const galleries = [
  { id: 'youcanup', title: copy.youcanup.name, screenshots: [
    { src: youcanupMenu, alt: copy.youcanup.menuAlt },
    { src: youcanupGameplay, alt: copy.youcanup.gameplayAlt },
  ] },
  { id: 'pinyiye', title: copy.pinyiye.name, screenshots: [
    { src: pinyiyeEditor, alt: copy.pinyiye.editorAlt },
    { src: pinyiyeWeekend, alt: copy.pinyiye.weekendAlt },
    { src: pinyiyeSunshine, alt: copy.pinyiye.sunshineAlt },
    { src: pinyiyeExport, alt: copy.pinyiye.exportAlt },
  ] },
  ...games.map(game => ({ ...game, screenshots: game.screenshots.map((src, index) => ({ src, alt: `${game.title} ${index + 1}` })) })),
];
---

<BaseLayout title={copy.title} description={copy.description} rawTitle playground>
  <main id="main" class="playground-home">
    <section class="playground-hero" aria-labelledby="studio-title">
      <div class="hero-copy">
        <h1 id="studio-title" class="display-type">{copy.headline.map(line => <span>{line}</span>)}</h1>
        <p class="hero-intro">{copy.intro}</p>
        <a class="explore-button" href="#works">{copy.explore}<svg viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
      </div>
      <div class="hero-art" aria-hidden="true"><Image src={hero} alt="" widths={[768, 1280, 1920, 2241]} sizes="100vw" format="webp" quality={90} loading="eager" fetchpriority="high" /></div>
    </section>

    <section id="works" class="selected-work" aria-labelledby="works-title">
      <h2 id="works-title" class="display-type">{copy.selected}</h2>
      <div class="products">
        <article id="pinyiye" class="product product-pinyiye" aria-labelledby="pinyiye-title">
          <button type="button" class="pinyiye-artwork" data-gallery="gallery-pinyiye" aria-label={`${copy.pinyiye.name} — ${copy.screenshot}`} aria-haspopup="dialog">
            <span class="pinyiye-print pinyiye-print-weekend"><Image src={pinyiyeWeekend} alt="" width={360} format="webp" loading="lazy" /></span>
            <span class="pinyiye-print pinyiye-print-sunshine"><Image src={pinyiyeSunshine} alt="" width={360} format="webp" loading="lazy" /></span>
            <span class="pinyiye-phone"><Image src={pinyiyeEditor} alt={copy.pinyiye.editorAlt} width={440} format="webp" loading="lazy" /></span>
            <span class="artwork-hint" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="M9 4H4v5m11-5h5v5M4 15v5h5m11-5v5h-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
          </button>
          <div class="product-info pinyiye-info">
            <div class="pinyiye-brand"><Image src={pinyiyeIcon} alt="" width={112} format="webp" loading="lazy" /><h3 id="pinyiye-title">{copy.pinyiye.name}</h3></div>
            <p class="product-description">{copy.pinyiye.tagline} {copy.pinyiye.description}</p>
            <ul class="pinyiye-features">{copy.pinyiye.features.map(feature => <li>{feature}</li>)}</ul>
            <div class="pinyiye-meta"><span class="product-type">{copy.pinyiye.platform}</span><span class="product-status">{copy.pinyiye.status}</span></div>
            <button type="button" class="pinyiye-preview" data-gallery="gallery-pinyiye" aria-haspopup="dialog">{copy.pinyiye.preview}<span aria-hidden="true">↗</span></button>
          </div>
        </article>
        <article id="youcanup" class="product product-youcanup" aria-labelledby="youcanup-title">
          <button type="button" class="youcanup-artwork" data-gallery="gallery-youcanup" aria-label={`${copy.youcanup.name} — ${copy.screenshot}`} aria-haspopup="dialog">
            <span class="youcanup-screen youcanup-screen-gameplay"><Image src={youcanupGameplay} alt={copy.youcanup.gameplayAlt} width={440} format="webp" loading="lazy" /></span>
            <span class="youcanup-screen youcanup-screen-menu"><Image src={youcanupMenu} alt={copy.youcanup.menuAlt} width={440} format="webp" loading="lazy" /></span>
            <span class="artwork-hint" aria-hidden="true">↗</span>
          </button>
          <div class="product-info youcanup-info">
            <div class="youcanup-brand"><Image src={youcanupIcon} alt="" width={112} format="webp" loading="lazy" /><div><h3 id="youcanup-title">{copy.youcanup.name}</h3>{lang !== 'en' && <span class="youcanup-english-name">YouCanUp</span>}</div></div>
            <p class="youcanup-tagline">{copy.youcanup.tagline}</p>
            <p class="product-description">{copy.youcanup.description}</p>
            <ul class="youcanup-features">{copy.youcanup.features.map(feature => <li>{feature}</li>)}</ul>
            <div class="youcanup-meta"><span class="product-type">{copy.game} · iOS</span><span class="product-status">{copy.coming}</span></div>
            <button type="button" class="youcanup-preview" data-gallery="gallery-youcanup" aria-haspopup="dialog">{copy.screenshot}<span aria-hidden="true">↗</span></button>
          </div>
        </article>
        {games.map(game => (
          <article id={game.id} class:list={['product', game.available ? 'product-breakout' : 'product-flappy']}>
            <button type="button" class="product-artwork" data-gallery={`gallery-${game.id}`} aria-label={`${game.title} — ${copy.screenshot}`} aria-haspopup="dialog">
              {/* The approved promotional phone artwork is a CSS image sprite. All surrounding copy is live HTML. */}
              <span class="phone-art"><img src={artwork.src} width={1024} height={1536} alt="" loading="lazy" decoding="async" /></span>
              <span class="artwork-hint" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="M9 4H4v5m11-5h5v5M4 15v5h5m11-5v5h-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
            </button>
            <div class="product-info">
              <h3>{game.lines.map(line => <span>{line}</span>)}</h3>
              <p class="product-description">{game.description}</p>
              <span class="product-type">{copy.game}{game.platform && ` · ${game.platform}`}</span>
              <span class:list={['product-status', { 'is-available': game.available }]}>{game.available ? copy.available : copy.coming}</span>
              {game.available && <a class="app-store-button" href="https://apps.apple.com/us/app/minimalist-breakout/id6776583255" target="_blank" rel="noopener noreferrer" aria-label={`${game.title} — App Store`}>
                <svg class="apple-icon" viewBox="0 0 24 28" aria-hidden="true"><path fill="currentColor" d="M19.65 14.73c.03 4.02 3.53 5.36 3.57 5.38-.03.09-.56 1.92-1.84 3.81-1.11 1.64-2.27 3.27-4.09 3.3-1.79.04-2.37-1.07-4.42-1.07-2.05 0-2.69 1.04-4.39 1.11-1.75.07-3.09-1.78-4.21-3.41C1.98 20.5.01 14.45 2.37 10.36c1.17-2.03 3.26-3.31 5.53-3.35 1.72-.03 3.34 1.18 4.4 1.18 1.05 0 3.02-1.46 5.09-1.25.87.04 3.32.35 4.89 2.65-.13.08-2.92 1.7-2.89 5.14h.26ZM16.23 4.68c.93-1.12 1.56-2.68 1.39-4.24-1.34.05-2.96.89-3.92 2.01-.86.98-1.62 2.54-1.42 4.04 1.5.12 3.01-.76 3.95-1.81Z" /></svg>
                <span>{lang === 'en' ? <><small>{copy.download}</small><strong>App Store</strong></> : <><strong>{copy.download} App Store</strong><small>{lang === 'zh-tw' ? '下載' : '下载'}</small></>}</span>
              </a>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="studio-values" aria-labelledby="values-title">
      <h2 id="values-title" class="display-type">{copy.philosophy}</h2>
      <div class="values-row">
        {copy.values.map((value, index) => <div class="value">
          <StudioValueIcon index={index} />
          <div><h3>{value.title}</h3><p>{value.body}</p></div>
        </div>)}
      </div>
    </section>
  </main>

  {galleries.map(gallery => <dialog id={`gallery-${gallery.id}`} class="screenshot-dialog" aria-label={`${gallery.title} — ${copy.screenshot}`}>
    <div class="gallery-header"><h2>{gallery.title}</h2><button type="button" class="gallery-close" aria-label={copy.close}>×</button></div>
    <div class="gallery-slides">{gallery.screenshots.map(({ src, alt }, index) => <figure hidden={index !== 0}><Image src={src} alt={alt} width={440} format="webp" loading="lazy" /></figure>)}</div>
    <div class="gallery-controls"><button type="button" class="gallery-previous" aria-label={copy.previous}>←</button><span class="gallery-counter" aria-live="polite">1 / {gallery.screenshots.length}</span><button type="button" class="gallery-next" aria-label={copy.next}>→</button></div>
  </dialog>)}
</BaseLayout>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!reducedMotion.matches) {
    document.querySelector('.hero-copy')?.animate([{ opacity: 0, transform: 'translateY(10px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 450, easing: 'ease-out' });
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const isValues = entry.target.classList.contains('values-row');
        entry.target.animate(isValues
          ? [{ opacity: 0.65, clipPath: 'inset(0 6% 0 6%)' }, { opacity: 1, clipPath: 'inset(0)' }]
          : [{ opacity: 0.75, transform: 'translateY(12px)' }, { opacity: 1, transform: 'translateY(0)' }],
          { duration: 450, easing: 'cubic-bezier(.2,.7,.2,1)' });
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.2 });
    document.querySelectorAll('.product, .values-row').forEach(el => observer.observe(el));
  }

  document.querySelectorAll<HTMLDialogElement>('.screenshot-dialog').forEach(dialog => {
    const triggers = [...document.querySelectorAll<HTMLButtonElement>(`[data-gallery="${dialog.id}"]`)];
    let activeTrigger: HTMLButtonElement | undefined;
    const slides = [...dialog.querySelectorAll<HTMLElement>('figure')];
    const previous = dialog.querySelector<HTMLButtonElement>('.gallery-previous')!;
    const next = dialog.querySelector<HTMLButtonElement>('.gallery-next')!;
    const counter = dialog.querySelector('.gallery-counter')!;
    let current = 0;
    function display(index: number) {
      current = Math.max(0, Math.min(index, slides.length - 1));
      slides.forEach((slide, i) => { slide.hidden = i !== current; });
      previous.disabled = current === 0;
      next.disabled = current === slides.length - 1;
      counter.textContent = `${current + 1} / ${slides.length}`;
    }
    triggers.forEach(trigger => trigger.addEventListener('click', () => {
      activeTrigger = trigger;
      display(0);
      dialog.showModal();
      document.body.classList.add('gallery-open');
    }));
    previous.addEventListener('click', () => display(current - 1));
    next.addEventListener('click', () => display(current + 1));
    dialog.querySelector('.gallery-close')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => { document.body.classList.remove('gallery-open'); activeTrigger?.focus({ preventScroll: true }); });
    dialog.addEventListener('click', event => { if (event.target === dialog) { const rect = dialog.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close(); } });
    dialog.addEventListener('keydown', event => {
      if (event.key === 'ArrowRight') { event.preventDefault(); display(current + 1); }
      if (event.key === 'ArrowLeft') { event.preventDefault(); display(current - 1); }
    });
  });
</script>
